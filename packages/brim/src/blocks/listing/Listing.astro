---
import { normalizePagePath } from "../../content/ids.ts";
import { defaultScope } from "../../runtime/request-state.ts";
import "./listing.css";
import type { NodeScope } from "../../runtime/context.ts";
import config from "virtual:brim/config";
import { connect } from "../../runtime/connect.ts";
import { type ContentItem, getContentType, getItems, getTerms } from "../../runtime/content.ts";
import { tagsOf } from "../../content/tags.ts";
import { optionLabel, optionsOf, standardField } from "../../content/content-types.ts";
import { itemPicture } from "../../content/item-image.ts";
import type { ImageValue } from "../../content/types.ts";
import ListingCards from "./ListingCards.astro";
import { type BrowseState, type FilterValue, browseItems, prefillOf, queryItems } from "./query.ts";

const LABELS = {
  search: "Search",
  apply: "Apply",
  reset: "Clear all",
  results: "{count} results",
  empty: "Nothing matches what you picked.",
  pages: "Pages",
  previous: "Previous",
  next: "Next",
};

/**
 * Lists the items of a content type. Which items and in what order is the site's code: `filter`, `sort`, `order`,
 * `limit`, `exclude`. The owner changes what is listed by editing the items; selecting the listing in the editor
 * opens them, or adds one that lands in this list.
 *
 * Pass a function to write the markup of one item; without one, a plain card per item:
 *
 *   <Listing nodeId="guides" type="doc" filter={{ section: "Guides" }} sort="order">
 *     {(item) => <a href={item.url}>{item.title}</a>}
 *   </Listing>
 *
 * `facets`, `search` and `pageSize` let visitors narrow the list themselves, through the page's address
 * (`?brand=Marazzi&q=lemn&page=2`), drawn on the server with no script. A `controls` function receives the
 * whole state (`BrowseState`) to draw the search, facets and pages in the site's own markup instead.
 */
interface Props {
  nodeId: string;
  /** Key of the content type to list. */
  type: string;
  scope?: NodeScope;
  /** Only items whose fields have these values: `{ section: "Guides" }`, `{ featured: true }`, `{ tags: ["a", "b"] }`. */
  filter?: Record<string, FilterValue>;
  /** A field of the type, or `title`, `created`, `updated`. By default the newest first. */
  sort?: string;
  /** By default descending for `created` and `updated`, ascending for anything else. */
  order?: "ascending" | "descending";
  limit?: number;
  /** Items left out, by id: on an item's page, `exclude={item.id}` lists the others. */
  exclude?: string | string[];

  /** For the plain card only. */
  variation?: "grid" | "list";
  columns?: number;
  gap?: number;
  /** The image field the card shows; by default `image`, or the first one of a type without it, `false` for none. */
  image?: string | false;
  /** The text field the card shows; by default `description`, or the first one of a type without it, `false` for none. */
  text?: string | false;
  /** The field whose tags the card shows as labels; by default `tags`, `false` for none. */
  tags?: string | false;
  /** Whether each card links to its item's page. By default it does when the type has pages. */
  links?: boolean;
  imageAspectRatio?: "auto" | "square" | "video" | "portrait";

  /** Fields visitors pick values of, as checkboxes: `select`, `text`, `tags`, `number` or `boolean` fields. */
  facets?: string[];
  /** A search box: `true` searches the title and the type's text-like fields, a list names the fields to search. */
  search?: boolean | string[];
  /** How many items a page shows; visitors turn pages through the address. */
  pageSize?: number;
  /** Put before each of the listing's address parameters, for a page with more than one listing to browse. */
  paramPrefix?: string;
  /** Draws the search, facets, count and pages in the site's own markup, from the state; Brim then draws only the items. */
  controls?: (state: BrowseState<ContentItem>) => unknown;
  /** The words of the search, facets and pages, in the site's language. `{count}` in `results` is the number. */
  labels?: Partial<typeof LABELS>;

  /** Older names: `sort` and `order` with `created`/`title`, `limit`, and the card's options. */
  sortOn?: "created" | "title";
  sortOrder?: "ascending" | "descending";
  maxItems?: number;
  showImage?: boolean;
  showDescription?: boolean;
  enableItemLinks?: boolean;
}

const props = Astro.props;
const { nodeId, type: typeKey, scope = defaultScope() } = props;
const type = getContentType(typeKey);
const listed = queryItems(await getItems(typeKey), {
  filter: props.filter,
  // A type the owner puts in order lists in that order unless the code sorts it otherwise.
  sort: props.sort ?? props.sortOn ?? (type.ordered ? "position" : undefined),
  order: props.order ?? props.sortOrder,
  limit: props.limit ?? props.maxItems,
  exclude: props.exclude,
});

// Visitors narrow the list through the address, which only a page drawn on request has (the dev server and the
// Node server); a static copy, written once, lists every item.
const browsing = Boolean(props.facets?.length || props.search || props.pageSize) && config.mode !== "static";
const state: BrowseState<ContentItem> | undefined = browsing
  ? browseItems(
      listed,
      type.fields,
      {
        facets: props.facets,
        search: props.search,
        pageSize: props.pageSize,
        paramPrefix: props.paramPrefix,
        labels: browsing ? await referenceLabels(type) : undefined,
      },
      Astro.url.searchParams,
    )
  : undefined;
const items = state ? state.items : listed;

/**
 * What facets show for each value: the titles of the terms reference fields point at, by slug, and the labels of
 * select choices, both in the page's language.
 */
async function referenceLabels(of: typeof type): Promise<Record<string, Record<string, string>>> {
  const labels: Record<string, Record<string, string>> = {};
  for (const field of of.fields) {
    if (field.type === "select") {
      labels[field.name] = Object.fromEntries(
        optionsOf(field).map((option) => [option.value, optionLabel(field, option.value, Astro.currentLocale)]),
      );
      continue;
    }
    if (field.type !== "reference" || !field.to) continue;
    // A term not translated into the page's language yet shows in its own, never as its bare slug.
    labels[field.name] = Object.fromEntries([...(await getTerms(field.to))].map(([slug, term]) => [slug, term.title]));
  }
  return labels;
}
const words = { ...LABELS, ...props.labels };
const anchor = `listing-${nodeId}`;
const ownControls = typeof props.controls === "function";

const showsText = props.text !== false && props.showDescription !== false;
const textField =
  props.text ||
  (standardField(type, "description") ?? type.fields.find(({ type: kind }) => kind === "textarea" || kind === "text"))
    ?.name;
const tagsField = props.tags === false ? undefined : (props.tags ?? "tags");
const labels = (item: ContentItem): string[] => (tagsField ? tagsOf(item.data[tagsField]) : []);
const links = props.links ?? props.enableItemLinks ?? Boolean(type.component);
const showsImage = props.image !== false && props.showImage !== false;
const custom = Astro.slots.has("default");
const ownImage = (item: ContentItem): ImageValue | undefined => {
  if (!showsImage) return undefined;
  return props.image ? (item.data[props.image] as ImageValue | undefined) : itemPicture(type, item);
};
// A card with no picture of its own takes its item page's preview image, the one its shared links show.
const previews = new Map<string, Pick<ImageValue, "src" | "focus">>();
if (!custom && showsImage) {
  const { content } = await connect(config.databaseUrl, config.authToken);
  const missing = items.filter((item) => !ownImage(item)?.src);
  // One read for every card, not one per card: a long list on a remote database made a round trip for each.
  const seoByPath = missing.length > 0 ? await content.pageSeoSettings() : new Map();
  for (const item of missing) {
    const seo = seoByPath.get(normalizePagePath(item.url));
    if (seo?.image) previews.set(item.id, { src: seo.image, ...(seo.imageFocus && { focus: seo.imageFocus }) });
  }
}
const image = (item: ContentItem): ImageValue | undefined => {
  const own = ownImage(item);
  if (own?.src) return own;
  const preview = previews.get(item.id);
  return preview ? { ...preview, alt: item.title } : undefined;
};
const text = (item: ContentItem): string | undefined => {
  return showsText && textField ? (item.data[textField] as string | undefined) : undefined;
};

const rendered = custom ? await Promise.all(items.map((item) => Astro.slots.render("default", [item]))) : [];
// What the editor needs to open these items, or add one that lands in this list.
const marker = Astro.locals.brim.marker("listing", nodeId, scope, {
  type: type.key,
  count: state ? state.total : items.length,
  prefill: prefillOf(props.filter, type.fields),
});
---

{state ? (
  <div class="brim-listing-browser" id={anchor} {...marker}>
    {ownControls
      ? props.controls?.(state)
      : (state.searchable || state.facets.length > 0) && (
          <form class="brim-listing-browser__controls" method="get" action={`#${anchor}`}>
            {state.otherParams.map(([name, value]) => (
              <input type="hidden" name={name} value={value} />
            ))}
            {state.searchable && (
              <label class="brim-listing-browser__search">
                <span>{words.search}</span>
                <input type="search" name={state.searchParam} value={state.query} />
              </label>
            )}
            {state.facets.map((facet) => (
              <fieldset class="brim-listing-browser__facet">
                <legend>{facet.label}</legend>
                {facet.options.map((option) => (
                  <label class="brim-listing-browser__option">
                    <input type="checkbox" name={facet.param} value={option.value} checked={option.selected} />
                    <span>{option.label}</span>
                    <span class="brim-listing-browser__count">{option.count}</span>
                  </label>
                ))}
              </fieldset>
            ))}
            <div class="brim-listing-browser__actions">
              <button type="submit">{words.apply}</button>
              {state.narrowed && <a href={`${state.resetHref}#${anchor}`}>{words.reset}</a>}
            </div>
          </form>
        )}
    {!ownControls && (
      <p class="brim-listing-browser__summary" role="status">
        {words.results.replace("{count}", String(state.total))}
      </p>
    )}
    <div
      class="brim-listing"
      data-variation={props.variation === "list" ? "list" : "grid"}
      data-aspect={props.imageAspectRatio}
      style={`--brim-listing-columns:${Number(props.columns) || 3};--brim-listing-gap:${Number(props.gap) || 24}px`}
      {...(state ? {} : marker)}
    >
      <ListingCards
        items={items}
        rendered={rendered}
        custom={custom}
        links={links}
        image={image}
        text={text}
        labels={labels}
      />
    </div>
    {state.total === 0 && !ownControls && <p class="brim-listing-browser__empty">{words.empty}</p>}
    {state.pageCount > 1 && !ownControls && (
      <nav class="brim-listing-browser__pages" aria-label={words.pages}>
        {state.page > 1 && (
          <a href={`${state.pageHref(state.page - 1)}#${anchor}`} rel="prev">
            {words.previous}
          </a>
        )}
        {Array.from({ length: state.pageCount }, (_, index) => index + 1).map((page) => (
          <a href={`${state.pageHref(page)}#${anchor}`} aria-current={page === state.page ? "page" : undefined}>
            {page}
          </a>
        ))}
        {state.page < state.pageCount && (
          <a href={`${state.pageHref(state.page + 1)}#${anchor}`} rel="next">
            {words.next}
          </a>
        )}
      </nav>
    )}
  </div>
) : (
  <div
    class="brim-listing"
    data-variation={props.variation === "list" ? "list" : "grid"}
    data-aspect={props.imageAspectRatio}
    style={`--brim-listing-columns:${Number(props.columns) || 3};--brim-listing-gap:${Number(props.gap) || 24}px`}
    {...(state ? {} : marker)}
  >
    <ListingCards
      items={items}
      rendered={rendered}
      custom={custom}
      links={links}
      image={image}
      text={text}
      labels={labels}
    />
    {items.length === 0 && Astro.locals.brim.editing && (
      <p class="brim-listing__empty">No {type.label.toLowerCase()} here yet.</p>
    )}
  </div>
)}
