---
import { Button, Text } from "@brimsites/brimjs/components";

interface Props {
  id: string;
  title: string;
  text: string;
  cta: { text: string; url: string };
}

const { id, title, text, cta } = Astro.props;
---

<section class="section call-to-action-band">
  <div class="container call-to-action">
    <Text nodeId={`${id}-title`} as="h2">
      {title}
    </Text>
    <Text nodeId={`${id}-text`} class="lead">
      {text}
    </Text>
    <Button nodeId={`${id}-button`} text={cta.text} url={cta.url} variant="dark-2" size="lg" />
  </div>
</section>

<style>
  .call-to-action-band {
    background: var(--brim-theme-accent);
    color: var(--brim-theme-accent-contrast);
  }

  .call-to-action {
    display: grid;
    justify-items: start;
    gap: 1rem;
  }

  .call-to-action :global(:is(h2, p)) {
    margin: 0;
  }

  .call-to-action :global(.lead) {
    color: inherit;
  }
</style>
