---
import { Form, Text } from "@brimsites/brimjs/components";
import Site from "../layouts/Site.astro";

// Messages are checked against abuse and saved; the owner reads them under "Form responses" in the editor.
// On a host that only serves static files, forms need the Brim server part to receive messages.
---

<Site title="Contact" description="Write to us.">
  <section class="section">
    <div class="container contact">
      <div class="stack">
        <Text nodeId="contact-title" as="h1">
          Say hello.
        </Text>
        <Text nodeId="contact-lead" class="lead">
          This form already works: messages are kept in the editor, under Form responses.
        </Text>
      </div>
      {/* Turn the consent box on (showConsent) once the site has a privacy page to link. */}
      <Form nodeId="contact-form" formName="Contact" showConsent={false} />
    </div>
  </section>
</Site>

<style>
  .contact {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: clamp(2rem, 5vw, 4rem);
  }
</style>
