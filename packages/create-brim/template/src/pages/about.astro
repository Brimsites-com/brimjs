---
import { Accordion, RichText, Text } from "@brimsites/brimjs/components";
import Site from "../layouts/Site.astro";
---

<Site title="About" description="Who is behind this site.">
  <section class="section">
    <div class="container stack">
      <Text nodeId="about-title" as="h1">
        Say who you are.
      </Text>
      <RichText nodeId="about-body" class="lead">
        <p>This page is yours to write. Open it in the editor, click this paragraph and start typing.</p>
        <p>One sentence on what you do and one on who you do it for is a good beginning.</p>
      </RichText>
    </div>
  </section>

  <section class="section section--tinted">
    <div class="container">
      <Text nodeId="about-faq-title" as="h2">
        Questions you may have
      </Text>
      <Accordion
        nodeId="about-faq"
        items={[
          {
            title: "Can I change everything here myself?",
            content: "Every text, picture and link, in the browser. The layout stays in code, so an edit cannot break it.",
          },
          {
            title: "Where is what I write kept?",
            content: "In one SQLite file, .brim/data.db, and the pictures in public/uploads. Both stay out of git.",
          },
          {
            title: "Where can I host it?",
            content: "Anywhere Node runs. A static copy works on any host, without the editor and forms.",
          },
        ]}
      />
    </div>
  </section>
</Site>
