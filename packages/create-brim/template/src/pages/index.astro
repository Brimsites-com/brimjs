---
import CallToAction from "../components/CallToAction.astro";
import Steps from "../components/Steps.astro";
import Welcome from "../components/Welcome.astro";
import Site from "../layouts/Site.astro";
import { SITE_NAME } from "../components/navigation.ts";
---

<Site title={SITE_NAME} description="A new site, made with Brim.js.">
  <Welcome />

  <Steps
    id="home-steps"
    title="Start here."
    steps={[
      {
        title: "Make your account",
        text: "The editor asks who you are. Run this once, in the project's folder.",
        code: "npx brim user add you@example.com",
      },
      {
        title: "Change this page",
        text: "Sign in, click any text, picture or button, and save.",
        code: "/admin/edit",
      },
      {
        title: "Change the design",
        text: "Every section is an Astro component. Save the file and the page follows.",
        code: "src/pages/index.astro",
      },
      {
        title: "Put your agent to work",
        text: "It reads AGENTS.md before it builds, and edits the content through the site's own MCP.",
        code: "/admin/mcp",
      },
    ]}
  />

  <CallToAction
    id="home-cta"
    title="Now make it yours."
    text="This page is only here to say hello. Replace it, or tell your agent what site you have in mind."
    cta={{ text: "See every component", url: "/components" }}
  />
</Site>
