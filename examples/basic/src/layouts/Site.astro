---
import { Analytics, Footer, MobileMenu, Navbar, Seo, Setting } from "brimjs/components";
import { getSiteSettings } from "brimjs/content";
import { siteSettings } from "../site-settings.ts";
import type { FooterValue, NavbarValue } from "brimjs";

interface Props {
  /** Left out on an item's page, whose own title and description go in the head. */
  title?: string;
  description?: string;
  /** Also draws the links in a menu that opens over the page. */
  mobileMenu?: boolean;
}

const { title, description, mobileMenu = false } = Astro.props;
// From Site Settings: the owner changes the phone number and the profiles once, for every page.
const { phone, instagram } = await getSiteSettings(siteSettings);
const pages = [
  { label: "Home", href: "/" },
  { label: "About", href: "/about" },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo title={title} description={description} sameAs={[instagram]} />
  </head>
  <body>
    <Navbar nodeId="navbar" logoText="Acme Studio" items={pages}>
      {({ logoText, items }: NavbarValue) => (
        <nav>
          <a href="/">{logoText}</a>
          <ul>
            {items.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
                {item.children && (
                  <ul class="dropdown">
                    {item.children.map((child) => (
                      <li>
                        <a href={child.href}>
                          {child.image && <img src={child.image.src} alt={child.image.alt} />}
                          {child.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ul>
          {mobileMenu && (
            <MobileMenu label="Menu" closeLabel="Close menu">
              <ul>
                {items.map((item) => (
                  <li>
                    <a href={item.href}>{item.label}</a>
                  </li>
                ))}
              </ul>
            </MobileMenu>
          )}
        </nav>
      )}
    </Navbar>

    <main>
      <slot />
    </main>

    <Footer nodeId="footer" logoText="Acme Studio" groups={[{ title: "Pages", items: pages }]}>
      {({ logoText, groups }: FooterValue) => (
        <div>
          <strong>{logoText}</strong>
          {phone && (
            <a class="footer-phone" href={`tel:${phone.replace(/[^+\d]/g, "")}`}>
              <Setting name="phone" />
            </a>
          )}
          {groups.map((group) => (
            <section>
              <h2>{group.title}</h2>
              <ul>
                {group.items.map((item) => (
                  <li>
                    <a href={item.href}>{item.label}</a>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      )}
    </Footer>
    <Analytics policyHref="/about" />
  </body>
</html>
